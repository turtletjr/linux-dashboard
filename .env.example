# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual credentials.

# --- Dashboard login (HTTP Basic Auth) ---
# Required. Without both of these set, every request to the dashboard is
# rejected — the app fails closed rather than running unauthenticated.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Jellyfin ---
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=

# --- Pi-hole ---
PIHOLE_URL=http://192.168.1.10/api
PIHOLE_PASSWORD=

# --- qBittorrent ---
QBITTORRENT_URL=http://192.168.1.10:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# --- Media integrity check (optional; defaults shown) ---
# MEDIA_LIBRARY=/mnt/Media
# MEDIA_REPORT=/home/<your-user>/bad_media_files.txt
# MEDIA_CHECK_SCRIPT=/home/<your-user>/linux-dashboard/check_media_headers.sh

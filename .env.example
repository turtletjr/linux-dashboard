# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual credentials.

# --- Dashboard login (HTTP Basic Auth) ---
# Required. Without both of these set, every request to the dashboard is
# rejected — the app fails closed rather than running unauthenticated.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Jellyfin ---
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=

# --- Pi-hole ---
PIHOLE_URL=http://192.168.1.10/api
PIHOLE_PASSWORD=

# --- qBittorrent ---
QBITTORRENT_URL=http://192.168.1.10:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# --- Media integrity check (optional; defaults shown) ---
# MEDIA_LIBRARY=/mnt/Media
# MEDIA_REPORT=/home/<your-user>/bad_media_files.txt
# MEDIA_CHECK_SCRIPT=/home/<your-user>/linux-dashboard/check_media_headers.sh

# --- TV remote (Google TV / Android TV) ---
# LAN IP of the TV. Pair once with: python tools/tv_remote_test.py pair
TV_IP=
# TV_CERT_DIR=~/.config/dashboard-tv   # where the pairing certificate is stored (outside the repo)
# TV_ADB=1            # launch apps over ADB when `adb` is installed (0 = never)
# TV_ADB_PORT=5555
# TV_JELLYFIN_CLIENT=Wholphin   # name of the TV's Jellyfin app as Jellyfin reports it
# TV_JELLYFIN_USER_ID=          # Jellyfin user the TV app is signed in as (auto-detected if blank)

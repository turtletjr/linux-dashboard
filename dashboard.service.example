
# Example systemd unit for running the dashboard as a persistent service.
#
# 1. Copy this file to /etc/systemd/system/dashboard.service
# 2. Replace every <PLACEHOLDER> below with your actual values
# 3. Run:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now dashboard
#
# Check status/logs with:
#      sudo systemctl status dashboard
#      sudo journalctl -u dashboard -f

[Unit]
Description=Linux Server Dashboard
After=network.target

[Service]
Type=simple
User=<YOUR_USERNAME>
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=<PATH_TO_PROJECT>
ExecStart=<PATH_TO_PROJECT>/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

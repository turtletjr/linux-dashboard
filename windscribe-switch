#!/usr/bin/env bash
#
# windscribe-switch — switch between Windscribe WireGuard locations
#   using ONE shared template (rules) + one small file per location.
#   No more duplicated rule blocks.
#
# A location is EITHER of these, dropped into /etc/wireguard/locations/:
#
#   <anything>.conf   A WireGuard config exactly as downloaded from Windscribe.
#                     Nothing to copy, paste or reformat. The location name is
#                     derived from the filename:
#                       Windscribe-Boston-Harvard-WG.conf  ->  Boston-Harvard
#                     (a leading "Windscribe-" and trailing "-WG" are dropped,
#                      and anything other than letters/digits/_/- becomes "-")
#
#   <name>.env        The older format (PRIVATE_KEY, ADDRESS, PUBLIC_KEY,
#                     ENDPOINT, PRESHARED_KEY). Still supported.
#
# If a .conf and a .env resolve to the same name, the .conf wins.
#
# Layout expected:
#   /etc/wireguard/windscribe.template.conf   (shared rules, edit once)
#   /etc/wireguard/locations/                 (.conf and/or .env files)
#   /etc/wireguard/windscribe.conf            (generated — do not edit by hand)
#
# From a Windscribe .conf only these are used: PrivateKey, Address, PublicKey,
# PresharedKey, Endpoint. Everything else (DNS, AllowedIPs, keepalive, ...) comes
# from the shared template, so your routing rules apply to every location.
#
# Usage:
#   sudo windscribe-switch list
#   sudo windscribe-switch status
#   sudo windscribe-switch up <name>
#   sudo windscribe-switch down
#
set -euo pipefail

WG_DIR="/etc/wireguard"
LOC_DIR="${WG_DIR}/locations"
TEMPLATE="${WG_DIR}/windscribe.template.conf"
CONF="${WG_DIR}/windscribe.conf"
IFACE="windscribe"
STATE_FILE="${WG_DIR}/.windscribe-active-location"
HANDSHAKE_WAIT=4   # seconds to wait before checking for a real handshake
NAME_RE='^[A-Za-z0-9_-]+$'

# Only these get substituted — anything else with a literal $ in the
# template (awk fields, command substitution, %i) is left untouched.
SUBST_VARS='${PRIVATE_KEY} ${ADDRESS} ${PUBLIC_KEY} ${ENDPOINT} ${PRESHARED_KEY}'

usage() {
    echo "Usage: $0 {list|status|up <name>|down}"
    echo
    echo "Available locations:"
    list_locations
    exit 1
}

require_tools() {
    command -v envsubst >/dev/null 2>&1 || {
        echo "envsubst not found. Install it with: sudo apt-get install gettext-base" >&2
        exit 1
    }
}

# Location name for a Windscribe .conf filename (basename, with extension).
#   Windscribe-Boston-Harvard-WG.conf -> Boston-Harvard
derive_name() {
    local base="${1%.conf}"
    base="${base#Windscribe-}"; base="${base#windscribe-}"
    base="${base%-WG}";         base="${base%-wg}"
    printf '%s' "$base" | sed -E 's/[^A-Za-z0-9_-]+/-/g; s/^-+//; s/-+$//'
}

# Prints the file that defines location $1 (.conf preferred over .env).
# Returns 1 if there is none.
find_location_file() {
    local name="$1" f
    for f in "$LOC_DIR"/*.conf; do
        [ -e "$f" ] || continue
        if [ "$(derive_name "$(basename "$f")")" = "$name" ]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    if [ -f "${LOC_DIR}/${name}.env" ]; then
        printf '%s\n' "${LOC_DIR}/${name}.env"
        return 0
    fi
    return 1
}

list_locations() {
    if [ ! -d "$LOC_DIR" ]; then
        echo "  (none found — create $LOC_DIR and add Windscribe .conf files)"
        return
    fi
    local names f n
    names=$(
        for f in "$LOC_DIR"/*.conf; do
            [ -e "$f" ] || continue
            n=$(derive_name "$(basename "$f")")
            [ -n "$n" ] && printf '%s\n' "$n"
        done
        for f in "$LOC_DIR"/*.env; do
            [ -e "$f" ] || continue
            basename "$f" .env
        done
    )
    if [ -z "$names" ]; then
        echo "  (none found — add Windscribe .conf files or <name>.env files to $LOC_DIR)"
        return
    fi
    printf '%s\n' "$names" | sort -u | sed 's/^/  /'
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Reads a WireGuard .conf WITHOUT executing it (no source/eval) and sets the
# five variables the template needs. Tolerates CRLF line endings, comments,
# blank lines, and keys/sections in any letter case. Values are split on the
# FIRST '=', so base64 keys ending in '=' are preserved.
load_conf() {
    local file="$1" section="" line key val
    PRIVATE_KEY="" ADDRESS="" PUBLIC_KEY="" ENDPOINT="" PRESHARED_KEY=""
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        line=$(trim "$line")
        case "$line" in
            ''|'#'*|';'*) continue ;;
            \[*\]) section="${line,,}"; continue ;;
        esac
        case "$line" in *=*) ;; *) continue ;; esac
        key=$(trim "${line%%=*}"); key="${key,,}"
        val=$(trim "${line#*=}")
        case "${section}.${key}" in
            '[interface].privatekey') PRIVATE_KEY="$val" ;;
            '[interface].address')    ADDRESS="$val" ;;
            '[peer].publickey')       PUBLIC_KEY="$val" ;;
            '[peer].presharedkey')    PRESHARED_KEY="$val" ;;
            '[peer].endpoint')        ENDPOINT="$val" ;;
        esac
    done < "$file"
    export PRIVATE_KEY ADDRESS PUBLIC_KEY ENDPOINT PRESHARED_KEY
}

current_location() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    else
        echo "(none)"
    fi
}

is_up() {
    wg show interfaces 2>/dev/null | grep -qx "$IFACE"
}

cmd_status() {
    echo "Active location: $(current_location)"
    if is_up; then
        echo "Interface state: up"
        wg show "$IFACE" latest-handshakes 2>/dev/null || true
    else
        echo "Interface state: down"
    fi
}

cmd_down() {
    if is_up; then
        echo "Bringing down $IFACE ($(current_location))..."
        wg-quick down "$IFACE"
    else
        echo "$IFACE is not up."
    fi
    rm -f "$STATE_FILE"
}

# Checks for a nonzero WireGuard handshake timestamp on the current
# interface. Echoes the timestamp (0 if none) and returns 1 if no
# real handshake has happened yet.
check_handshake() {
    local hs
    hs=$(wg show "$IFACE" latest-handshakes 2>/dev/null | awk '{print $2}')
    hs="${hs:-0}"
    echo "$hs"
    [ "$hs" != "0" ]
}

cmd_up() {
    local name="$1"
    local no_revert="${2:-false}"
    local varfile
    local previous
    previous=$(current_location)

    require_tools

    if ! [[ "$name" =~ $NAME_RE ]]; then
        echo "Invalid location name: $name" >&2
        exit 1
    fi
    if ! varfile=$(find_location_file "$name"); then
        echo "No such location: $name (looked in $LOC_DIR)" >&2
        echo "Available locations:" >&2
        list_locations >&2
        exit 1
    fi
    if [ ! -f "$TEMPLATE" ]; then
        echo "Template missing: $TEMPLATE" >&2
        exit 1
    fi

    # Tear down the currently active connection first so PostDown
    # for the OLD location runs before we overwrite the config.
    if is_up; then
        echo "Switching from $previous — bringing down first..."
        wg-quick down "$IFACE"
    fi

    echo "Loading $name from $varfile..."
    case "$varfile" in
        *.conf)
            load_conf "$varfile"
            ;;
        *)
            set -a
            # shellcheck disable=SC1090
            source "$varfile"
            set +a
            ;;
    esac

    for v in PRIVATE_KEY ADDRESS PUBLIC_KEY ENDPOINT PRESHARED_KEY; do
        if [ -z "${!v:-}" ]; then
            echo "Missing or empty required value: $v (check $varfile)" >&2
            exit 1
        fi
    done

    echo "Generating $CONF..."
    envsubst "$SUBST_VARS" < "$TEMPLATE" > "$CONF"
    chmod 600 "$CONF"

    echo "$name" > "$STATE_FILE"

    echo "Bringing up $IFACE ($name)..."
    wg-quick up "$IFACE"

    echo "Waiting ${HANDSHAKE_WAIT}s to verify handshake..."
    sleep "$HANDSHAKE_WAIT"

    local hs
    hs=$(check_handshake) || {
        echo "WARNING: no handshake with '$name' after ${HANDSHAKE_WAIT}s." >&2

        if [ "$no_revert" = "true" ]; then
            echo "Already attempting a revert — leaving $IFACE down to avoid a loop." >&2
            wg-quick down "$IFACE" 2>/dev/null || true
            rm -f "$STATE_FILE"
            exit 1
        fi

        if [ "$previous" != "(none)" ] && find_location_file "$previous" >/dev/null; then
            echo "Auto-reverting to previous location: $previous" >&2
            wg-quick down "$IFACE" 2>/dev/null || true
            cmd_up "$previous" true
            echo "Reverted. '$name' did not connect — check its file ($varfile) for bad keys or endpoint." >&2
            exit 1
        else
            echo "No previous location to revert to — bringing $IFACE down for safety." >&2
            wg-quick down "$IFACE" 2>/dev/null || true
            rm -f "$STATE_FILE"
            exit 1
        fi
    }

    echo "Handshake confirmed with $name (${hs})."
}

if [ "$EUID" -ne 0 ]; then
    echo "This script needs root (it calls wg-quick and writes to /etc/wireguard). Try sudo." >&2
    exit 1
fi

case "${1:-}" in
    list)
        list_locations
        ;;
    status)
        cmd_status
        ;;
    up)
        [ $# -eq 2 ] || usage
        cmd_up "$2"
        ;;
    down)
        cmd_down
        ;;
    *)
        usage
        ;;
esac

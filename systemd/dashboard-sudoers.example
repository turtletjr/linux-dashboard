# The dashboard runs as an unprivileged user but shells out to a handful of
# commands that need root. Rather than grant broad sudo access, scope it to
# exactly these commands.
#
# 1. Replace <YOUR_USERNAME> with the user the dashboard service runs as
#    (this should match the User= line in your systemd unit).
# 2. Save this file to /etc/sudoers.d/dashboard
# 3. Set correct permissions:  sudo chmod 440 /etc/sudoers.d/dashboard
# 4. Validate syntax before trusting it:  sudo visudo -c
#
# NOTE: NOPASSWD /usr/bin/kill and /usr/bin/systemctl are still fairly broad —
# the app validates PIDs/services against its own monitored list before
# calling them, but sudoers itself has no concept of that. Anyone who can
# execute code as <YOUR_USERNAME> can already use these rules directly.
# Combine this with authentication on the dashboard's control endpoints
# (see README) rather than treating this file alone as the security boundary.
#
# NOTE: /usr/bin/umount and /usr/bin/mount are used by the drive "Unmount" and
# "Mount All" buttons. The app only ever runs a plain (non-forced) umount on a
# mount point it has just confirmed is a currently-mounted, non-system drive,
# and `mount -a` (which only touches what is already listed in /etc/fstab), but
# sudoers cannot enforce that, so the same caveat as kill/systemctl applies.

<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/sbin/smartctl
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/bin/wg
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/bin/systemctl
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/sbin/shutdown
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/bin/apt-get
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/bin/kill
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/bin/umount
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/bin/mount
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/local/bin/pihole, /usr/bin/pihole
<YOUR_USERNAME> ALL=(root) NOPASSWD: /usr/local/bin/windscribe-switch
